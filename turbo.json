{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["JWT_SECRET", "WS_PORT", "PORT", "DATABASE_URL", "JWT_EXPIRES_IN", "NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_HTTP_URL", "NEXT_PUBLIC_WS__URL"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
