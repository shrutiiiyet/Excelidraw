{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*", "**/.env"],
  "globalEnv": [
    "NODE_ENV",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "DATABASE_URL",
    "WS_PORT",
    "HTTP_PORT",
    "PORT",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "generated/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
