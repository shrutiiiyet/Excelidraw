
{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "excelidraw-frontend": {
      "root": "apps/excelidraw-frontend",
      "framework": "nextjs",
      "installCommand": "corepack pnpm@9.0.0 install --frozen-lockfile --prod=false",
      "buildCommand": "cd ../.. && pnpm run build"
    },

    "http-backend": {
      "root": "apps/http-backend",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "installCommand": "corepack pnpm@9.0.0 install --frozen-lockfile --prod=false",
      "buildCommand": "cd ../.. && pnpm run build"
    },
    "ws-backend": {
      "root": "apps/ws-backend",
      "entrypoint": "src/server.ts",
      "installCommand": "corepack pnpm@9.0.0 install --frozen-lockfile --prod=false",
      "buildCommand": "cd ../.. && pnpm run build"
    }
  },

  "rewrites": [
    {
      "source": "/ws",
      "destination": {
        "service": "ws-backend"
      }
    },
    {
      "source": "/ws/(.*)",
      "destination": {
        "service": "ws-backend"
      }
    },

    {
      "source": "/auth",
      "destination": {
        "service": "http-backend"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "http-backend"
      }
    },

    {
      "source": "/room",
      "destination": {
        "service": "http-backend"
      }
    },
    {
      "source": "/room/(.*)",
      "destination": {
        "service": "http-backend"
      }
    },

    {
      "source": "/canvas",
      "destination": {
        "service": "http-backend"
      }
    },
    {
      "source": "/canvas/(.*)",
      "destination": {
        "service": "http-backend"
      }
    },

    {
      "source": "/(.*)",
      "destination": {
        "service": "excelidraw-frontend"
      }
    }
  ]
}